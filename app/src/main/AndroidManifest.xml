<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Stay in front": Android 10+ blocks returning to the front from the background without this. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 1.0.12: read-only, to show the album art in the playing track's folder (no write permission is asked for). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- fix13: install a downloaded EverSignal update from the pill. Android asks the owner once; nothing installs without their tap. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:requestLegacyExternalStorage="true"
        android:label="EverSignal"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:usesCleartextTraffic="true">
        <!-- Cleartext: the player's API is plain HTTP on 127.0.0.1:9529. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".KeepOnTopService" android:exported="false" />
    </application>
</manifest>
